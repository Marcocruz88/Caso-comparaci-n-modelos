      "source": [
        "n_features = XTrain.shape[1]\n",
        "kf = KFold(n_splits=5, shuffle=True, random_state=42)\n",
        "\n",
        "seleccionados = []\n",
        "disponibles = list(range(n_features))\n",
        "mejor_mse = np.inf\n",
        "historial_mse = []"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 10,
      "id": "40740850",
